---
import Base from '../../layouts/Base.astro';
import siteData from '../../data/site-data.json';
import { cleanText, dealMetadata } from '../../lib/deal-metadata.mjs';
import { serializeStructuredData } from '../../lib/structured-data.mjs';

export async function getStaticPaths() {
  return siteData.posts.map(deal => ({
    params: { slug: deal.slug },
    props: { deal },
  }));
}

const { deal } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = `https://deals.shoppingwithnoya.com/deals/${deal.slug}`;

// Prefer the real CDN URL the scraper captured. The legacy
// images-na.ssl-images-amazon.com/images/P/{ASIN} endpoint is unofficial and
// answers HTTP 200 with a 43-byte blank pixel when it has no image for an ASIN
// -- measured 8/12 blank on a live sample, so the page silently showed nothing
// and the og:image/JSON-LD advertised an empty picture.
const imgUrl = deal.imageUrl
  || (deal.asin
    ? `https://images-na.ssl-images-amazon.com/images/P/${deal.asin}.01._SCLZZZZZZZ_.jpg`
    : null);

const { title: pageTitle, description: pageDesc } = dealMetadata(deal);
const productName = cleanText(deal.title) || 'Product deal';
// No manufacturer description is supplied yet; a short, honest checking note
// is preferable to inventing specifications or repeating the entire heading.
const productDescription = 'Check current price, availability and any coupon conditions at the retailer.';

const dateFormatted = new Date(deal.ts).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York'
});

function ratingColor(r: string) {
  if (r === 'FIRE') return '#ef4444';
  if (r === 'HOT')  return '#f97316';
  if (r === 'WARM') return '#eab308';
  if (r === 'GOOD') return '#22c55e';
  return '#3b82f6';
}
const color = ratingColor(deal.rating);

// Informational affiliate page, not a merchant offer. The current feed has
// no approved exact-price/brand provenance. Do not infer a price from "$X.xx",
// assert stock, invent an expiry, or name this affiliate site as the seller.
// Price-rich results remain blocked until an approved data source is available.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: canonicalUrl,
  name: pageTitle,
  description: pageDesc,
  about: {
    '@type': 'Product',
    name: productName,
    description: productDescription,
    ...(imgUrl && { image: imgUrl }),
    ...(deal.asin && { sku: deal.asin }),
  },
};
---

<Base title={pageTitle} description={pageDesc} image={imgUrl || undefined} url={canonicalUrl} type="product">

  <script type="application/ld+json" set:html={serializeStructuredData(jsonLd)} />

  <article class="deal-page">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={base || '/'}>Home</a> › <span>{deal.category}</span>
    </nav>

    <div class="deal-layout">

      <!-- Image -->
      <div class="deal-img-wrap">
        {imgUrl
          ? <img src={imgUrl} alt={deal.title} width="300" height="300" />
          : <div class="img-placeholder">📦</div>
        }
      </div>

      <!-- Info -->
      <div class="deal-info">
        <p class="deal-category">{deal.category}</p>
        <h1 class="deal-title">{productName}</h1>
        <p class="deal-summary">{productDescription}</p>

        <div class="deal-badges">
          {deal.discount > 0 && (
            <span class="badge-discount" style={`background:${color}`}>💸 {deal.discount}% OFF</span>
          )}
          {deal.price && (
            <span class="badge-price">💵 {deal.price}</span>
          )}
          <span class="badge-rating" style={`color:${color};border-color:${color}`}>{deal.rating}</span>
        </div>

        {deal.asin && <p class="deal-asin">ASIN: {deal.asin}</p>}
        <p class="deal-date">Posted {dateFormatted}</p>

        <a href={deal.url} class="deal-btn" target="_blank" rel="noopener nofollow">
          🛒 Grab This Deal →
        </a>

        <!-- Share buttons -->
        <div class="share-row">
          <span class="share-label">Share this deal:</span>
          <a class="share-btn share-fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener" aria-label="Share on Facebook">👥 Facebook</a>
          <a class="share-btn share-tg" href={`https://t.me/share/url?url=${encodeURIComponent(canonicalUrl)}&text=${encodeURIComponent(deal.title.replace(/[^\x00-\x7F]/g, ''))}`} target="_blank" rel="noopener" aria-label="Share on Telegram">✈️ Telegram</a>
          <a class="share-btn share-tw" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalUrl)}&text=${encodeURIComponent(('🔥 Check out this deal: ' + deal.title).replace(/[^\x00-\x7F]/g, ''))}`} target="_blank" rel="noopener" aria-label="Share on X">🐦 X</a>
          <button class="share-btn share-copy" data-url={canonicalUrl} onclick="navigator.clipboard.writeText(this.dataset.url).then(()=>{this.textContent='✅ Copied!';setTimeout(()=>this.textContent='🔗 Copy Link',2000)})" aria-label="Copy link">🔗 Copy Link</button>
        </div>

        <p class="deal-disclosure">#ad — As an affiliate partner I earn from qualifying purchases.</p>
      </div>
    </div>

    <!-- Telegram CTA -->
    <div class="tg-cta">
      <strong>🔔 Want deals like this every day?</strong>
      <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener">
        Join our free Telegram channel @shoppingwithnoya →
      </a>
    </div>

    <a href={base || '/'} class="back-link">← Back to all deals</a>

  </article>

</Base>

<style>
  .deal-page { max-width: 900px; margin: 0 auto; }
  .breadcrumb { font-size: 0.8rem; color: #94a3b8; margin-bottom: 24px; }
  .breadcrumb a { color: #94a3b8; }
  .breadcrumb a:hover { color: #94a3b8; }

  .deal-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }
  @media (max-width: 640px) { .deal-layout { grid-template-columns: 1fr; } }

  .deal-img-wrap {
    background: #1e293b; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    padding: 20px; min-height: 260px;
  }
  .deal-img-wrap img { width: 100%; height: auto; border-radius: 8px; object-fit: contain; max-height: 280px; }
  .img-placeholder { font-size: 5rem; }

  .deal-category { font-size: 0.8rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
  .deal-summary { color: #cbd5e1; line-height: 1.6; margin-bottom: 16px; overflow-wrap: anywhere; }
  .deal-title { font-size: 1.5rem; font-weight: 700; line-height: 1.3; margin-bottom: 16px; overflow-wrap: anywhere; }

  .deal-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .badge-discount { font-size: 0.85rem; padding: 5px 12px; border-radius: 20px; color: #fff; font-weight: 600; }
  .badge-price { font-size: 0.85rem; padding: 5px 12px; border-radius: 20px; background: #14532d; color: #86efac; font-weight: 600; }
  .badge-rating { font-size: 0.85rem; padding: 5px 12px; border-radius: 20px; border: 1px solid; background: transparent; font-weight: 600; }

  .deal-asin { font-size: 0.78rem; color: #94a3b8; margin-bottom: 4px; font-family: monospace; }
  .deal-date { font-size: 0.8rem; color: #94a3b8; margin-bottom: 24px; }

  .deal-btn {
    display: inline-block; background: #f59e0b; color: #0f172a;
    padding: 14px 28px; border-radius: 10px; font-weight: 700; font-size: 1rem;
    transition: background 0.15s; margin-bottom: 16px;
  }
  .deal-btn:hover { background: #d97706; text-decoration: none; }

  .deal-disclosure { font-size: 0.72rem; color: #94a3b8; }

  .share-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    margin-bottom: 16px;
  }
  .share-label { font-size: 0.8rem; color: #94a3b8; }
  .share-btn {
    font-size: 0.78rem; padding: 6px 12px; border-radius: 20px;
    background: #1e293b; color: #e2e8f0; border: 1px solid #334155;
    cursor: pointer; text-decoration: none; transition: background 0.15s;
    font-family: inherit;
  }
  .share-btn:hover { background: #334155; text-decoration: none; }
  .share-fb { border-color: #1877f2; color: #60a5fa; }
  .share-tg { border-color: #0088cc; color: #60a5fa; }
  .share-tw { border-color: #1da1f2; color: #60a5fa; }

  .tg-cta {
    background: #0c2340; border: 1px solid #0088cc44;
    border-radius: 12px; padding: 20px 24px;
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    margin-bottom: 24px; font-size: 0.95rem;
  }
  .tg-cta a { color: #60a5fa; font-weight: 600; }

  .back-link { font-size: 0.85rem; color: #94a3b8; }
  .back-link:hover { color: #94a3b8; }
</style>
