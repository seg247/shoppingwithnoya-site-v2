---
import beautyData from '../../data/beauty-blog-data.json';

const posts        = beautyData.posts || [];
const latestPost   = posts[0];
const canonicalUrl = 'https://deals.shoppingwithnoya.com/beauty/';
const pageTitle    = 'Best Beauty Deals Today — Skincare, Makeup & Hair | Shopping With Noya';
const pageDesc     = 'Daily beauty deals hand-picked and updated every day. Find the best discounts on skincare, makeup, hair care, fragrance and more at Shopping With Noya.';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Beauty Deals — Shopping With Noya",
  "description": pageDesc,
  "url": canonicalUrl,
  "publisher": { "@type": "Organization", "name": "Shopping With Noya", "url": "https://deals.shoppingwithnoya.com" },
  "blogPost": posts.slice(0, 10).map(p => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "datePublished": p.date,
    "url": `https://deals.shoppingwithnoya.com/beauty/${p.date}/`,
    "description": p.intro,
  }))
});

const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Where can I find the best beauty deals today?", "acceptedAnswer": { "@type": "Answer", "text": "Shopping With Noya publishes daily beauty deal roundups at deals.shoppingwithnoya.com/beauty with discounts on skincare, makeup, hair care, fragrance, and body care. Deals are hand-picked and updated daily." } },
    { "@type": "Question", "name": "What beauty brands are featured?", "acceptedAnswer": { "@type": "Answer", "text": "We feature deals from top brands including CeraVe, Neutrogena, NYX, Maybelline, Olaplex, It's a 10, Sun Bum, Tarte, and more — all available through affiliate partner links." } },
    { "@type": "Question", "name": "How often are beauty deals updated?", "acceptedAnswer": { "@type": "Answer", "text": "Beauty deals are sourced and updated daily. A new roundup is published each morning featuring the best available beauty discounts of the day." } },
  ]
});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:site_name"   content="Shopping With Noya" />
  <meta name="twitter:card"        content="summary" />
  <meta name="twitter:title"       content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <script type="application/ld+json" set:html={jsonLd} />
  <script type="application/ld+json" set:html={faqLd} />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T75YM7DVKJ"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-T75YM7DVKJ');</script>
  <style is:inline>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--bg:#0a0a0f;--surface:#13131a;--surface2:#1a1a24;--text:#f0f0f5;--muted:#8888a0;--accent:#ff3cac;--purple:#7b2fff;--cyan:#00d4ff;--border:rgba(255,255,255,0.08)}
    html{background:var(--bg);color:var(--text);font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.6}
    a{color:inherit;text-decoration:none}
    .site-nav{position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:10px;padding:0 20px;height:54px;background:rgba(10,10,15,0.9);backdrop-filter:blur(18px);border-bottom:1px solid var(--border)}
    .nav-brand{font-size:1rem;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--purple),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .nav-gap{flex:1}
    .nav-pill{font-size:0.72rem;font-weight:600;padding:5px 13px;border-radius:999px;border:1px solid var(--border);color:var(--muted);white-space:nowrap;transition:color .15s,background .15s}
    .nav-pill:hover{color:var(--text);background:var(--surface2)}
    .nav-cta{font-size:0.72rem;font-weight:700;padding:5px 13px;border-radius:999px;background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;white-space:nowrap}
    .nav-cta:hover{opacity:0.88}
    .wrap{max-width:860px;margin:0 auto;padding:36px 20px 80px}
    .crumb{font-size:0.72rem;color:var(--muted);margin-bottom:18px}
    .crumb a{color:var(--muted)}
    .crumb a:hover{color:var(--text)}
    .hero{margin-bottom:40px}
    .hero h1{font-size:2rem;font-weight:800;line-height:1.25;margin-bottom:12px}
    .hero-intro{font-size:0.92rem;color:#94a3b8;line-height:1.7;padding:14px 16px;background:var(--surface);border-left:3px solid var(--accent);border-radius:0 10px 10px 0;margin-bottom:20px}
    .cat-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px}
    .cat-pill{font-size:0.75rem;font-weight:600;padding:6px 14px;border-radius:999px;background:var(--surface);border:1px solid var(--border);color:var(--muted);transition:border-color .15s,color .15s}
    .cat-pill:hover{border-color:var(--accent);color:var(--text)}
    .section-h2{font-size:1.15rem;font-weight:700;margin-bottom:20px;padding-bottom:10px;border-bottom:1px solid var(--border)}
    .post-list{display:flex;flex-direction:column;gap:14px;margin-bottom:40px}
    .post-card{background:var(--surface);border-radius:16px;padding:20px 24px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;border:1px solid var(--border);transition:background .15s,transform .1s;text-decoration:none;color:var(--text)}
    .post-card:hover{background:var(--surface2);transform:translateY(-2px)}
    .post-card-body{flex:1}
    .post-title{font-size:1rem;font-weight:700;margin-bottom:6px;line-height:1.3}
    .post-meta{font-size:0.78rem;color:var(--muted);margin-bottom:8px}
    .post-cats{display:flex;flex-wrap:wrap;gap:6px}
    .cat-tag{font-size:0.7rem;padding:3px 9px;border-radius:20px;background:var(--surface2);color:var(--muted);border:1px solid var(--border)}
    .post-arrow{font-size:1.3rem;color:var(--muted);flex-shrink:0;margin-top:2px}
    .tg-box{background:linear-gradient(135deg,rgba(255,60,172,0.08),rgba(123,47,255,0.08));border:1px solid rgba(255,60,172,0.18);border-radius:16px;padding:24px;margin-bottom:36px}
    .tg-box h3{font-size:1rem;margin-bottom:8px;font-weight:700}
    .tg-box p{font-size:0.85rem;color:var(--muted);margin-bottom:16px;line-height:1.6}
    .tg-btn{display:inline-block;padding:10px 22px;background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;border-radius:999px;font-weight:700;font-size:0.85rem}
    .faq-section{margin-bottom:36px}
    .faq-h2{font-size:1.1rem;font-weight:700;margin-bottom:18px;padding-bottom:10px;border-bottom:1px solid var(--border)}
    .faq-item{margin-bottom:12px;background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden}
    .faq-q{font-size:0.88rem;font-weight:700;padding:14px 16px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:8px;line-height:1.4}
    .faq-q:hover{background:var(--surface2)}
    .faq-icon{font-size:0.8rem;color:var(--muted);flex-shrink:0;transition:transform .2s}
    .faq-a{font-size:0.83rem;color:var(--muted);padding:0 16px 14px;line-height:1.7;display:none}
    .faq-item.open .faq-a{display:block}
    .faq-item.open .faq-icon{transform:rotate(180deg)}
    .disc{font-size:0.68rem;color:#4b5563;margin-top:20px;line-height:1.5}
    .site-footer{border-top:1px solid var(--border);padding:22px 20px;text-align:center;font-size:0.75rem;color:var(--muted)}
    .site-footer a{color:var(--muted)}
    .site-footer a:hover{color:var(--text)}
    .foot-disc{font-size:0.65rem;opacity:0.4;margin-top:6px}
    .empty{text-align:center;padding:60px 0;color:var(--muted);font-size:0.9rem}
  </style>
</head>
<body>
  <nav class="site-nav">
    <a href="/" class="nav-brand">🛍️ Shopping With Noya</a>
    <div class="nav-gap"></div>
    <a href="/" class="nav-pill">All Deals</a>
    <a href="/blog/" class="nav-pill">Blog</a>
    <a href="/beauty/" class="nav-pill" aria-current="page">💄 Beauty</a>
    <a href="https://t.me/shoppingwithnoya" class="nav-cta" target="_blank" rel="noopener">📲 Telegram</a>
  </nav>

  <main class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a> › Beauty Deals
    </nav>

    <div class="hero">
      <h1>💄 Best Beauty Deals Today</h1>
      <!-- AEO: answer-first paragraph -->
      <p class="hero-intro">
        Shopping With Noya's beauty deals page features daily hand-picked discounts on skincare, makeup, hair care, fragrance, nails, and body care. Deals are sourced from top brands and updated every day — bookmark this page and never pay full price for beauty products again.
      </p>
    </div>

    <!-- Category filter pills (internal nav) -->
    <nav class="cat-pills" aria-label="Beauty categories">
      <a href="/beauty/" class="cat-pill">✨ All Beauty</a>
      <a href="/beauty/" class="cat-pill">🧴 Skincare</a>
      <a href="/beauty/" class="cat-pill">💋 Makeup</a>
      <a href="/beauty/" class="cat-pill">💇 Hair Care</a>
      <a href="/beauty/" class="cat-pill">💅 Nails</a>
      <a href="/beauty/" class="cat-pill">🌸 Fragrance</a>
      <a href="/beauty/" class="cat-pill">🫧 Body Care</a>
    </nav>

    <!-- DAILY DEAL ROUNDUPS -->
    {posts.length > 0 ? (
      <>
        <h2 class="section-h2">📅 Daily Beauty Deal Roundups</h2>
        <div class="post-list" role="list">
          {posts.map(p => {
            const fmtDate = new Date(p.date + 'T12:00:00').toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric', year:'numeric' });
            return (
              <a href={`/beauty/${p.date}/`} class="post-card" role="listitem">
                <div class="post-card-body">
                  <div class="post-title">{p.title}</div>
                  <div class="post-meta">{fmtDate} &nbsp;·&nbsp; {p.deals?.length ?? 0} beauty deals</div>
                  <div class="post-cats">
                    {(p.subcats || []).slice(0, 4).map(s => (
                      <span class="cat-tag">{s}</span>
                    ))}
                  </div>
                </div>
                <span class="post-arrow">→</span>
              </a>
            );
          })}
        </div>
      </>
    ) : (
      <p class="empty">Beauty deals roundups coming soon — check back daily! 💄</p>
    )}

    <!-- CTA -->
    <div class="tg-box">
      <h3>💄 Get Beauty Deals Instantly!</h3>
      <p>Join our free Telegram channel for instant beauty deal alerts — skincare, makeup, hair care and more delivered straight to your phone.</p>
      <a href="https://t.me/shoppingwithnoya" class="tg-btn" target="_blank" rel="noopener noreferrer">📲 Join Free → @shoppingwithnoya</a>
    </div>

    <!-- FAQ — AEO -->
    <section class="faq-section" aria-labelledby="faq-heading">
      <h2 class="faq-h2" id="faq-heading">❓ Beauty Deals FAQ</h2>
      <div class="faq-item">
        <div class="faq-q" role="button" tabindex="0" aria-expanded="false"><span>Where can I find the best beauty deals today?</span><span class="faq-icon">▼</span></div>
        <div class="faq-a">Shopping With Noya publishes daily beauty deal roundups at deals.shoppingwithnoya.com/beauty with discounts on skincare, makeup, hair care, fragrance, and body care. Deals are hand-picked and updated daily.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q" role="button" tabindex="0" aria-expanded="false"><span>What beauty brands are featured?</span><span class="faq-icon">▼</span></div>
        <div class="faq-a">We feature deals from top brands including CeraVe, Neutrogena, NYX, Maybelline, Olaplex, It's a 10, Sun Bum, Tarte, and more — all available through affiliate partner links.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q" role="button" tabindex="0" aria-expanded="false"><span>How often are beauty deals updated?</span><span class="faq-icon">▼</span></div>
        <div class="faq-a">Beauty deals are sourced and updated daily. A new roundup is published each morning featuring the best available beauty discounts of the day.</div>
      </div>
    </section>

    <p class="disc">#ad — Shopping With Noya participates in affiliate programs. As an Amazon Associate and affiliate partner, we earn from qualifying purchases at no extra cost to you.</p>
  </main>

  <footer class="site-footer">
    <a href="/blog/">Deal Blog</a> &nbsp;·&nbsp;
    <a href="/beauty/">Beauty Deals</a> &nbsp;·&nbsp;
    <a href="/">All Deals</a> &nbsp;·&nbsp;
    <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener">📲 Telegram</a>
    <p class="foot-disc">#ad — As an Amazon Associate and affiliate partner I earn from qualifying purchases.</p>
  </footer>

  <script>
    document.querySelectorAll('.faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(el => { el.classList.remove('open'); el.querySelector('.faq-q').setAttribute('aria-expanded','false'); });
        if (!isOpen) { item.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
      });
      btn.addEventListener('keydown', e => { if (e.key==='Enter'||e.key===' '){e.preventDefault();btn.click();} });
    });
  </script>
</body>
</html>
