---
import blogData from '../../data/blog-data.json';

export async function getStaticPaths() {
  return (blogData.posts || []).map(post => ({
    params: { date: post.date },
    props: { post },
  }));
}

const { post } = Astro.props;
const { date } = Astro.params;
const canonicalUrl = `https://deals.shoppingwithnoya.com/blog/${date}/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title id="page-title">Daily Deals — Shopping With Noya</title>
  <meta name="description" id="page-desc" content="Hand-picked deals updated daily. Save big on electronics, home, beauty and more at Shopping With Noya." />
  <link rel="canonical" href={`https://deals.shoppingwithnoya.com/blog/${date}/`} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://deals.shoppingwithnoya.com/blog/${date}/`} />
  <meta property="og:site_name" content="Shopping With Noya" />
  <meta property="og:locale" content="en_US" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T75YM7DVKJ"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-T75YM7DVKJ');</script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --bg: #0a0a0f; --surface: #13131a; --surface2: #1a1a24; --text: #f0f0f5; --text-sec: #a0a0b0; --accent: #ff3cac; --purple: #7b2fff; --cyan: #00d4ff; --border: rgba(255,255,255,0.08); }
    html { background: var(--bg); color: var(--text); font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; gap: 8px;
      padding: 0 1.5rem; height: 56px;
      background: rgba(10,10,15,0.85);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo { font-size: 1.1rem; font-weight: 700; text-decoration: none; flex-shrink: 0; background: linear-gradient(135deg, var(--accent), var(--purple), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .nav-spacer { flex: 1; }
    .nav-link { font-size: 0.78rem; font-weight: 600; color: var(--text); text-decoration: none; white-space: nowrap; flex-shrink: 0; padding: 0.4rem 0.75rem; border-radius: 999px; border: 1px solid var(--border); transition: background 0.2s; }
    .nav-link:hover { background: var(--surface2); text-decoration: none; }
    .nav-tg { display: flex; align-items: center; gap: 0.3rem; padding: 0.4rem 0.75rem; background: linear-gradient(135deg, var(--accent), var(--purple)); color: white !important; text-decoration: none; border-radius: 999px; font-size: 0.78rem; font-weight: 600; transition: opacity 0.2s; flex-shrink: 0; white-space: nowrap; }
    .nav-tg:hover { opacity: 0.85; text-decoration: none; }

    .page-body { max-width: 860px; margin: 0 auto; padding: 40px 24px; }
    .breadcrumb { font-size: 0.8rem; color: var(--text-sec); margin-bottom: 24px; }
    .breadcrumb a { color: var(--text-sec); }
    h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 12px; line-height: 1.3; }
    .post-meta { color: var(--text-sec); font-size: 0.85rem; margin-bottom: 20px; }
    .post-intro { color: #cbd5e1; line-height: 1.7; margin-bottom: 36px; font-size: 0.98rem; }

    .deals-list { display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 40px; }
    @media (min-width: 600px) { .deals-list { grid-template-columns: 1fr 1fr; } }
    .deal-row {
      background: var(--surface); border-radius: 20px; padding: 0;
      display: flex; flex-direction: column;
      text-decoration: none; color: var(--text);
      border: 1px solid var(--border);
      overflow: hidden;
      transition: transform 0.18s, box-shadow 0.18s;
    }
    .deal-row:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(255,60,172,0.15); text-decoration: none; }
    .deal-img-wrap { width: 100%; aspect-ratio: 1/1; background: var(--surface2); position: relative; overflow: hidden; }
    .deal-img { width: 100%; height: 100%; object-fit: contain; padding: 16px; }
    .deal-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3.5rem; }
    .deal-badge-overlay { position: absolute; top: 10px; left: 10px; }
    .badge-off { font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; font-weight: 700; box-shadow: 0 2px 8px rgba(239,68,68,0.4); }
    .deal-body { flex: 1; padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; }
    .deal-title { font-size: 0.88rem; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; color: var(--text); }
    .deal-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-top: auto; }
    .badge-cat { font-size: 0.7rem; padding: 3px 9px; border-radius: 20px; background: rgba(123,47,255,0.2); color: #a78bfa; border: 1px solid rgba(123,47,255,0.3); }
    .deal-cta { display: block; text-align: center; margin: 0 16px 16px; padding: 9px; background: linear-gradient(135deg, var(--accent), var(--purple)); color: #fff !important; border-radius: 10px; font-size: 0.8rem; font-weight: 700; text-decoration: none; transition: opacity 0.2s; }
    .deal-cta:hover { opacity: 0.85; text-decoration: none; }

    .share-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 32px; padding: 16px; background: var(--surface); border-radius: 14px; border: 1px solid var(--border); }
    .share-label { font-size: 0.82rem; color: var(--text-sec); width: 100%; margin-bottom: 4px; }
    .share-btn { font-size: 0.78rem; padding: 7px 16px; border-radius: 20px; background: var(--surface2); color: var(--text); border: 1px solid var(--border); cursor: pointer; text-decoration: none; font-family: inherit; transition: background 0.15s, transform 0.1s; font-weight: 500; }
    .share-btn:hover { background: var(--border); transform: scale(1.04); text-decoration: none; }

    .tg-cta { background: linear-gradient(135deg, rgba(255,60,172,0.12), rgba(123,47,255,0.12)); border: 1px solid rgba(255,60,172,0.25); border-radius: 16px; padding: 24px 28px; margin-bottom: 32px; }
    .tg-cta h3 { margin-bottom: 8px; font-size: 1.1rem; }
    .tg-cta p { color: var(--text-sec); font-size: 0.9rem; margin-bottom: 16px; }
    .tg-btn { display: inline-block; background: linear-gradient(135deg, var(--accent), var(--purple)); color: #fff !important; padding: 11px 24px; border-radius: 999px; font-weight: 700; font-size: 0.9rem; text-decoration: none; }

    .disclosure { font-size: 0.72rem; color: #475569; margin-bottom: 24px; }
    .back-link { font-size: 0.85rem; color: var(--text-sec); }
    .loading { text-align: center; color: var(--text-sec); padding: 60px 0; }

    footer { margin-top: 60px; border-top: 1px solid var(--border); }
    .footer-inner { max-width: 1200px; margin: 0 auto; padding: 24px; text-align: center; font-size: 0.8rem; color: var(--text-sec); }
    .disclaimer { font-size: 0.72rem; opacity: 0.5; margin-top: 6px; }
    a { color: var(--cyan); text-decoration: none; }
  </style>
</head>
<body>

  <nav>
    <a href="/" class="nav-logo">🛍️ Shopping With Noya</a>
    <div class="nav-spacer"></div>
    <a href="/blog/" class="nav-link">📝 Blog</a>
    <a href="https://t.me/shoppingwithnoya" class="nav-tg" target="_blank" rel="noopener">📲 Telegram</a>
  </nav>

  <div class="page-body" id="page-body">
    <div class="loading">Loading deals...</div>
  </div>

  <footer>
    <div class="footer-inner">
      <a href="/blog/">← Back to blog</a> &nbsp;·&nbsp;
      <a href="/">All deals</a> &nbsp;·&nbsp;
      <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener">📲 Telegram</a>
      <p class="disclaimer">#ad — As an affiliate partner I earn from qualifying purchases.</p>
    </div>
  </footer>

  <script define:vars={{ date }}>
    const pageUrl = `https://deals.shoppingwithnoya.com/blog/${date}/`;

    function ratingColor(r) {
      if (r === 'FIRE') return '#ef4444';
      if (r === 'HOT')  return '#f97316';
      if (r === 'WARM') return '#eab308';
      return '#22c55e';
    }

    async function loadPost() {
      const body = document.getElementById('page-body');
      try {
        const res = await fetch('/blog-data.json?t=' + Date.now());
        if (!res.ok) throw new Error('Not found');
        const data = await res.json();
        const post = (data.posts || []).find(p => p.date === date || p.slug === date);

        if (!post) {
          body.innerHTML = '<div class="loading">Post not found. <a href="/blog/">Back to blog →</a></div>';
          return;
        }

        // Update meta tags dynamically
        document.getElementById('page-title').textContent = post.title + ' — Shopping With Noya';
        document.getElementById('page-desc').setAttribute('content', post.intro);
        document.querySelector('meta[property="og:title"]')?.setAttribute('content', post.title);
        document.querySelector('meta[property="og:description"]')?.setAttribute('content', post.intro);

        const dealsHtml = post.deals.map(d => {
          const imgContent = d.imageUrl
            ? `<img class="deal-img" src="${d.imageUrl}" alt="${d.title.replace(/"/g,'')}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
               <div class="deal-img-placeholder" style="display:none">📦</div>`
            : `<div class="deal-img-placeholder">📦</div>`;
          const discBadge = d.discount > 0 ? `<div class="deal-badge-overlay"><span class="badge-off">🔥 ${d.discount}% OFF</span></div>` : '';
          const catBadge = d.category && d.category !== 'Other' ? `<span class="badge-cat">${d.category}</span>` : '';
          return `
            <a href="/deals/${d.slug}/" class="deal-row">
              <div class="deal-img-wrap">
                ${imgContent}
                ${discBadge}
              </div>
              <div class="deal-body">
                <div class="deal-title">${d.title}</div>
                <div class="deal-badges">${catBadge}</div>
              </div>
              <span class="deal-cta">View Deal →</span>
            </a>`;
        }).join('');

        const postDate = new Date(post.date + 'T12:00:00').toLocaleDateString('en-US', {
          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
        });

        const encodedUrl = encodeURIComponent(pageUrl);
        const encodedTitle = encodeURIComponent(post.title.replace(/[^\x00-\x7F]/g, ''));

        body.innerHTML = `
          <nav class="breadcrumb"><a href="/blog/">Blog</a> › ${postDate}</nav>
          <h1>${post.title}</h1>
          <p class="post-meta">${postDate} · ${post.deals.length} deals</p>
          <p class="post-intro">${post.intro}</p>

          <div class="share-row">
            <span class="share-label">Share:</span>
            <a class="share-btn" href="https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}" target="_blank" rel="noopener">📘 Facebook</a>
            <a class="share-btn" href="https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}" target="_blank" rel="noopener">✈️ Telegram</a>
            <a class="share-btn" href="https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}" target="_blank" rel="noopener">🐦 X</a>
            <button class="share-btn" onclick="navigator.clipboard.writeText('${pageUrl}').then(()=>{this.textContent='✅ Copied!';setTimeout(()=>this.textContent='🔗 Copy Link',2000)})">🔗 Copy Link</button>
          </div>

          <div class="deals-list">${dealsHtml}</div>

          <div class="tg-cta">
            <h3>🔔 Never miss a deal!</h3>
            <p>Join our free Telegram channel and get the best deals delivered instantly — before they sell out.</p>
            <a href="https://t.me/shoppingwithnoya" class="tg-btn" target="_blank" rel="noopener">📲 Join @shoppingwithnoya — It's Free</a>
          </div>

          <p class="disclosure">#ad — As an affiliate partner I earn from qualifying purchases.</p>
          <a href="/blog/" class="back-link">← Back to blog</a>
        `;
      } catch (e) {
        body.innerHTML = '<div class="loading">Could not load post. <a href="/blog/">Back to blog →</a></div>';
      }
    }

    loadPost();
  </script>

</body>
</html>
