---
import blogData from '../../data/blog-data.json';

export async function getStaticPaths() {
  return (blogData.posts || []).map(post => ({
    params: { date: post.date },
    props: { post },
  }));
}

const { post } = Astro.props;
const { date } = Astro.params;

const canonicalUrl = `https://deals.shoppingwithnoya.com/blog/${date}/`;
const pageTitle    = `${post.title} — Shopping With Noya`;
const pageDesc     = post.intro || `Top deals for ${date} — hand-picked savings on electronics, home, beauty and more.`;
const ogImage      = post.deals?.[0]?.imageUrl || 'https://deals.shoppingwithnoya.com/og-image.jpg';
const fmtDate      = new Date(date + 'T12:00:00').toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
const dealCount    = post.deals?.length ?? 0;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": pageDesc,
  "datePublished": date,
  "dateModified": date,
  "url": canonicalUrl,
  "image": ogImage,
  "author": { "@type": "Organization", "name": "Shopping With Noya", "url": "https://deals.shoppingwithnoya.com" },
  "publisher": { "@type": "Organization", "name": "Shopping With Noya", "url": "https://deals.shoppingwithnoya.com" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl }
});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type"        content="article" />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:site_name"   content="Shopping With Noya" />
  <meta property="og:locale"      content="en_US" />
  <meta property="article:published_time" content={date} />

  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={jsonLd} />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T75YM7DVKJ"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-T75YM7DVKJ');</script>
  <style is:inline>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--bg:#0a0a0f;--surface:#13131a;--surface2:#1c1c26;--text:#f0f0f5;--muted:#8888a0;--accent:#ff3cac;--purple:#7b2fff;--cyan:#00d4ff;--border:rgba(255,255,255,0.07)}
    html{background:var(--bg);color:var(--text);font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px}
    a{color:inherit;text-decoration:none}

    /* NAV */
    .site-nav{position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:10px;padding:0 20px;height:54px;background:rgba(10,10,15,0.9);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid var(--border)}
    .nav-brand{font-size:1rem;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--purple),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;flex-shrink:0}
    .nav-gap{flex:1}
    .nav-pill{font-size:0.72rem;font-weight:600;padding:5px 13px;border-radius:999px;border:1px solid var(--border);color:var(--muted);transition:color .15s,background .15s;white-space:nowrap}
    .nav-pill:hover{color:var(--text);background:var(--surface2)}
    .nav-cta{font-size:0.72rem;font-weight:700;padding:5px 13px;border-radius:999px;background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;white-space:nowrap}
    .nav-cta:hover{opacity:0.88}

    /* PAGE */
    .wrap{max-width:1100px;margin:0 auto;padding:28px 20px 80px}
    .crumb{font-size:0.72rem;color:var(--muted);margin-bottom:18px}
    .crumb a{color:var(--muted)}
    .crumb a:hover{color:var(--text)}
    .post-h1{font-size:1.6rem;font-weight:800;line-height:1.25;margin-bottom:6px}
    .post-meta{font-size:0.75rem;color:var(--muted);margin-bottom:10px}
    .post-intro{font-size:0.85rem;color:#94a3b8;line-height:1.6;margin-bottom:22px;padding-left:12px;border-left:3px solid var(--accent)}

    /* SHARE BAR */
    .share-bar{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-bottom:28px;padding:10px 14px;background:var(--surface);border:1px solid var(--border);border-radius:12px}
    .share-lbl{font-size:0.72rem;color:var(--muted);font-weight:600;margin-right:2px}
    .share-btn{font-size:0.72rem;font-weight:500;padding:5px 12px;border-radius:20px;background:var(--surface2);color:var(--text);border:1px solid var(--border);cursor:pointer;font-family:inherit;transition:border-color .15s}
    .share-btn:hover{border-color:var(--accent)}

    /* GRID — mobile: 2col, tablet: 3col, desktop: 4col */
    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:36px}
    @media(min-width:600px){.grid{grid-template-columns:repeat(3,1fr)}}
    @media(min-width:900px){.grid{grid-template-columns:repeat(4,1fr)}}

    /* CARD */
    .card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:transform .15s,border-color .15s,box-shadow .15s}
    .card:hover{transform:translateY(-3px);border-color:rgba(255,60,172,0.3);box-shadow:0 8px 32px rgba(255,60,172,0.1)}
    .card-img-box{position:relative;width:100%;padding-top:85%;background:#fff;overflow:hidden}
    .card-img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:10px}
    .card-img-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:2rem;background:var(--surface2)}
    .card-badge{position:absolute;top:7px;left:7px;font-size:0.6rem;font-weight:700;padding:2px 7px;border-radius:20px;background:linear-gradient(135deg,#ef4444,#b91c1c);color:#fff;white-space:nowrap;box-shadow:0 2px 6px rgba(239,68,68,0.4)}
    .card-body{padding:10px 12px 6px;flex:1;display:flex;flex-direction:column;gap:5px}
    .card-title{font-size:0.75rem;font-weight:600;line-height:1.35;color:var(--text);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .card-cat{font-size:0.6rem;padding:2px 7px;border-radius:20px;background:rgba(123,47,255,0.15);color:#a78bfa;border:1px solid rgba(123,47,255,0.25);display:inline-block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
    .card-btn{display:block;text-align:center;margin:6px 10px 10px;padding:7px 4px;background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;border-radius:8px;font-size:0.68rem;font-weight:700;transition:opacity .2s}
    .card-btn:hover{opacity:0.85}

    /* TG CTA */
    .tg-box{background:linear-gradient(135deg,rgba(255,60,172,0.08),rgba(123,47,255,0.08));border:1px solid rgba(255,60,172,0.18);border-radius:16px;padding:22px 22px;margin-bottom:24px}
    .tg-box h3{font-size:1rem;margin-bottom:6px}
    .tg-box p{font-size:0.82rem;color:var(--muted);margin-bottom:14px;line-height:1.5}
    .tg-btn{display:inline-block;padding:10px 22px;background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;border-radius:999px;font-weight:700;font-size:0.85rem}

    .disc{font-size:0.68rem;color:#4b5563;margin-bottom:18px}
    .back{font-size:0.8rem;color:var(--muted)}
    .back:hover{color:var(--text)}
    .loader{text-align:center;color:var(--muted);padding:80px 0;font-size:0.9rem}

    /* FOOTER */
    .site-footer{border-top:1px solid var(--border);padding:22px 20px;text-align:center;font-size:0.75rem;color:var(--muted)}
    .site-footer a{color:var(--muted)}
    .site-footer a:hover{color:var(--text)}
    .foot-disc{font-size:0.65rem;opacity:0.4;margin-top:6px}
  </style>
</head>
<body>

  <nav class="site-nav">
    <a href="/" class="nav-brand">🛍️ Shopping With Noya</a>
    <div class="nav-gap"></div>
    <a href="/" class="nav-pill">All Deals</a>
    <a href="/blog/" class="nav-pill">Blog</a>
    <a href="https://t.me/shoppingwithnoya" class="nav-cta" target="_blank" rel="noopener">📲 Telegram</a>
  </nav>

  <div class="wrap" id="page-body">
    <div class="loader">Loading deals…</div>
  </div>

  <footer class="site-footer">
    <a href="/blog/">← Back to blog</a> &nbsp;·&nbsp;
    <a href="/">All deals</a> &nbsp;·&nbsp;
    <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener">📲 Telegram</a>
    <p class="foot-disc">#ad — As an affiliate partner I earn from qualifying purchases.</p>
  </footer>

  <script define:vars={{ date }}>
    const pageUrl = `https://deals.shoppingwithnoya.com/blog/${date}/`;

    async function load() {
      const body = document.getElementById('page-body');
      try {
        const res = await fetch('/blog-data.json?t=' + Date.now());
        if (!res.ok) throw new Error();
        const data = await res.json();
        const post = (data.posts || []).find(p => p.date === date || p.slug === date);
        if (!post) { body.innerHTML = '<div class="loader">Post not found. <a href="/blog/">Back to blog →</a></div>'; return; }

        const fmtDate = new Date(post.date + 'T12:00:00').toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
        const encUrl  = encodeURIComponent(pageUrl);
        const encTxt  = encodeURIComponent(post.title.replace(/[^\x00-\x7F]/g,''));

        const cards = post.deals.map(d => {
          const img = d.imageUrl
            ? `<img class="card-img" src="${d.imageUrl}" alt="${d.title.replace(/"/g,'')}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"><div class="card-img-ph" style="display:none">📦</div>`
            : `<div class="card-img-ph">📦</div>`;
          const badge  = d.discount > 0 ? `<span class="card-badge">🔥 ${d.discount}% OFF</span>` : '';
          const catTag = d.category && d.category !== 'Other' ? `<span class="card-cat">${d.category}</span>` : '';
          return `<a href="/deals/${d.slug}/" class="card">
            <div class="card-img-box">${img}${badge}</div>
            <div class="card-body">
              <div class="card-title">${d.title}</div>
              ${catTag}
            </div>
            <span class="card-btn">View Deal →</span>
          </a>`;
        }).join('');

        body.innerHTML = `
          <p class="crumb"><a href="/blog/">Blog</a> › ${fmtDate}</p>
          <h1 class="post-h1">${post.title}</h1>
          <p class="post-meta">${fmtDate} &nbsp;·&nbsp; ${post.deals.length} deals</p>
          <p class="post-intro">${post.intro}</p>

          <div class="share-bar">
            <span class="share-lbl">Share:</span>
            <a class="share-btn" href="https://www.facebook.com/sharer/sharer.php?u=${encUrl}" target="_blank" rel="noopener">📘 Facebook</a>
            <a class="share-btn" href="https://t.me/share/url?url=${encUrl}&text=${encTxt}" target="_blank" rel="noopener">✈️ Telegram</a>
            <a class="share-btn" href="https://twitter.com/intent/tweet?url=${encUrl}&text=${encTxt}" target="_blank" rel="noopener">🐦 X</a>
            <button class="share-btn" onclick="navigator.clipboard.writeText('${pageUrl}').then(()=>{this.textContent='✅ Copied!';setTimeout(()=>this.textContent='🔗 Copy Link',2000)})">🔗 Copy Link</button>
          </div>

          <div class="grid">${cards}</div>

          <div class="tg-box">
            <h3>🔔 Never miss a deal!</h3>
            <p>Join our free Telegram channel — deals delivered instantly before they sell out.</p>
            <a href="https://t.me/shoppingwithnoya" class="tg-btn" target="_blank" rel="noopener">📲 Join Free → @shoppingwithnoya</a>
          </div>

          <p class="disc">#ad — As an affiliate partner I earn from qualifying purchases.</p>
          <a href="/blog/" class="back">← Back to all posts</a>
        `;
      } catch(e) {
        body.innerHTML = '<div class="loader">Could not load post. <a href="/blog/">Back →</a></div>';
      }
    }
    load();
  </script>

</body>
</html>
