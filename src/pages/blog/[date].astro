---
import blogData from '../../data/blog-data.json';

export async function getStaticPaths() {
  return (blogData.posts || []).map(post => ({
    params: { date: post.date },
    props: { post },
  }));
}

const { post } = Astro.props;
const { date } = Astro.params;
const canonicalUrl = `https://deals.shoppingwithnoya.com/blog/${date}/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title id="page-title">Daily Deals — Shopping With Noya</title>
  <meta name="description" id="page-desc" content="Hand-picked deals updated daily. Save big on electronics, home, beauty and more at Shopping With Noya." />
  <link rel="canonical" href={`https://deals.shoppingwithnoya.com/blog/${date}/`} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://deals.shoppingwithnoya.com/blog/${date}/`} />
  <meta property="og:site_name" content="Shopping With Noya" />
  <meta property="og:locale" content="en_US" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T75YM7DVKJ"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-T75YM7DVKJ');</script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --bg: #0f172a; --surface: #1e293b; --text: #e2e8f0; --muted: #94a3b8; --accent: #60a5fa; }
    html { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

    .nav-stripe { background: #0f172a; border-bottom: 1px solid #1e293b; width: 100%; }
    .nav-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; height: 60px; display: flex; align-items: center; justify-content: space-between; }
    .nav-brand { font-size: 1.15rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .nav-brand span { color: var(--accent); }
    .nav-cta { background: #0088cc; color: #fff !important; padding: 8px 18px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; }

    .page-body { max-width: 800px; margin: 0 auto; padding: 40px 24px; }

    .breadcrumb { font-size: 0.8rem; color: var(--muted); margin-bottom: 24px; }
    .breadcrumb a { color: var(--muted); }

    h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 12px; line-height: 1.3; }
    .post-meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 20px; }
    .post-intro { color: #cbd5e1; line-height: 1.7; margin-bottom: 36px; font-size: 0.98rem; }

    .deals-list { display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px; }
    .deal-row {
      background: var(--surface); border-radius: 12px; padding: 16px;
      display: flex; gap: 16px; align-items: center;
      text-decoration: none; color: var(--text);
      transition: background 0.15s, transform 0.1s;
    }
    .deal-row:hover { background: #243347; transform: translateY(-2px); text-decoration: none; }
    .deal-img { width: 70px; height: 70px; border-radius: 8px; object-fit: cover; background: #334155; flex-shrink: 0; }
    .deal-img-placeholder { width: 70px; height: 70px; border-radius: 8px; background: #334155; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0; }
    .deal-body { flex: 1; min-width: 0; }
    .deal-title { font-size: 0.9rem; font-weight: 600; line-height: 1.3; margin-bottom: 6px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .deal-badges { display: flex; flex-wrap: wrap; gap: 5px; }
    .badge-off { font-size: 0.7rem; padding: 2px 8px; border-radius: 20px; background: #ef4444; color: #fff; font-weight: 600; }
    .badge-cat { font-size: 0.7rem; padding: 2px 8px; border-radius: 20px; background: #334155; color: #94a3b8; }
    .deal-arrow { color: var(--muted); font-size: 1.2rem; flex-shrink: 0; }

    .share-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 32px; }
    .share-label { font-size: 0.82rem; color: var(--muted); }
    .share-btn { font-size: 0.78rem; padding: 6px 12px; border-radius: 20px; background: var(--surface); color: var(--text); border: 1px solid #334155; cursor: pointer; text-decoration: none; font-family: inherit; transition: background 0.15s; }
    .share-btn:hover { background: #334155; text-decoration: none; }

    .tg-cta { background: #0c2340; border: 1px solid #0088cc44; border-radius: 12px; padding: 20px 24px; margin-bottom: 32px; }
    .tg-cta h3 { margin-bottom: 8px; }
    .tg-cta p { color: var(--muted); font-size: 0.9rem; margin-bottom: 14px; }
    .tg-btn { display: inline-block; background: #0088cc; color: #fff !important; padding: 10px 22px; border-radius: 8px; font-weight: 700; font-size: 0.9rem; text-decoration: none; }

    .disclosure { font-size: 0.72rem; color: #475569; margin-bottom: 24px; }
    .back-link { font-size: 0.85rem; color: var(--muted); }

    .loading { text-align: center; color: var(--muted); padding: 60px 0; }

    footer { margin-top: 60px; border-top: 1px solid #1e293b; }
    .footer-inner { max-width: 1200px; margin: 0 auto; padding: 24px; text-align: center; font-size: 0.8rem; color: var(--muted); }
    .disclaimer { font-size: 0.72rem; opacity: 0.5; margin-top: 6px; }
    a { color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>

  <div class="nav-stripe">
    <div class="nav-inner">
      <a href="/" class="nav-brand">Shopping With <span>Noya</span></a>
      <a href="https://t.me/shoppingwithnoya" class="nav-cta" target="_blank" rel="noopener">📲 Join Telegram</a>
    </div>
  </div>

  <div class="page-body" id="page-body">
    <div class="loading">Loading deals...</div>
  </div>

  <footer>
    <div class="footer-inner">
      <a href="/blog/">← Back to blog</a> &nbsp;·&nbsp;
      <a href="/">All deals</a> &nbsp;·&nbsp;
      <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener">📲 Telegram</a>
      <p class="disclaimer">#ad — As an affiliate partner I earn from qualifying purchases.</p>
    </div>
  </footer>

  <script define:vars={{ date }}>
    const pageUrl = `https://deals.shoppingwithnoya.com/blog/${date}/`;

    function ratingColor(r) {
      if (r === 'FIRE') return '#ef4444';
      if (r === 'HOT')  return '#f97316';
      if (r === 'WARM') return '#eab308';
      return '#22c55e';
    }

    async function loadPost() {
      const body = document.getElementById('page-body');
      try {
        const res = await fetch('/blog-data.json?t=' + Date.now());
        if (!res.ok) throw new Error('Not found');
        const data = await res.json();
        const post = (data.posts || []).find(p => p.date === date || p.slug === date);

        if (!post) {
          body.innerHTML = '<div class="loading">Post not found. <a href="/blog/">Back to blog →</a></div>';
          return;
        }

        // Update meta tags dynamically
        document.getElementById('page-title').textContent = post.title + ' — Shopping With Noya';
        document.getElementById('page-desc').setAttribute('content', post.intro);
        document.querySelector('meta[property="og:title"]')?.setAttribute('content', post.title);
        document.querySelector('meta[property="og:description"]')?.setAttribute('content', post.intro);

        const dealsHtml = post.deals.map(d => {
          const img = d.imageUrl
            ? `<img class="deal-img" src="${d.imageUrl}" alt="" loading="lazy" width="70" height="70" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">`
            : '';
          const placeholder = `<div class="deal-img-placeholder" ${d.imageUrl ? 'style="display:none"' : ''}>📦</div>`;
          const discBadge = d.discount > 0 ? `<span class="badge-off">💸 ${d.discount}% OFF</span>` : '';
          const catBadge = d.category ? `<span class="badge-cat">${d.category}</span>` : '';
          return `
            <a href="/deals/${d.slug}/" class="deal-row">
              ${img}${placeholder}
              <div class="deal-body">
                <div class="deal-title">${d.title}</div>
                <div class="deal-badges">${discBadge}${catBadge}</div>
              </div>
              <div class="deal-arrow">›</div>
            </a>`;
        }).join('');

        const postDate = new Date(post.date + 'T12:00:00').toLocaleDateString('en-US', {
          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
        });

        const encodedUrl = encodeURIComponent(pageUrl);
        const encodedTitle = encodeURIComponent(post.title.replace(/[^\x00-\x7F]/g, ''));

        body.innerHTML = `
          <nav class="breadcrumb"><a href="/blog/">Blog</a> › ${postDate}</nav>
          <h1>${post.title}</h1>
          <p class="post-meta">${postDate} · ${post.deals.length} deals</p>
          <p class="post-intro">${post.intro}</p>

          <div class="share-row">
            <span class="share-label">Share:</span>
            <a class="share-btn" href="https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}" target="_blank" rel="noopener">📘 Facebook</a>
            <a class="share-btn" href="https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}" target="_blank" rel="noopener">✈️ Telegram</a>
            <a class="share-btn" href="https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}" target="_blank" rel="noopener">🐦 X</a>
            <button class="share-btn" onclick="navigator.clipboard.writeText('${pageUrl}').then(()=>{this.textContent='✅ Copied!';setTimeout(()=>this.textContent='🔗 Copy Link',2000)})">🔗 Copy Link</button>
          </div>

          <div class="deals-list">${dealsHtml}</div>

          <div class="tg-cta">
            <h3>🔔 Never miss a deal!</h3>
            <p>Join our free Telegram channel and get the best deals delivered instantly — before they sell out.</p>
            <a href="https://t.me/shoppingwithnoya" class="tg-btn" target="_blank" rel="noopener">📲 Join @shoppingwithnoya — It's Free</a>
          </div>

          <p class="disclosure">#ad — As an affiliate partner I earn from qualifying purchases.</p>
          <a href="/blog/" class="back-link">← Back to blog</a>
        `;
      } catch (e) {
        body.innerHTML = '<div class="loading">Could not load post. <a href="/blog/">Back to blog →</a></div>';
      }
    }

    loadPost();
  </script>

</body>
</html>
