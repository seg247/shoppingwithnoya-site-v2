---
// /blog — dynamic blog index, loads blog-data.json at runtime
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Deal Blog — Shopping With Noya</title>
  <meta name="description" content="Daily deal roundups, top savings, and hand-picked discounts updated every day. Never miss a deal from Shopping With Noya." />
  <meta name="keywords" content="daily deals, deal roundup, best deals today, shopping deals, affiliate deals, discount roundup" />
  <link rel="canonical" href="https://deals.shoppingwithnoya.com/blog/" />
  <meta property="og:title" content="Deal Blog — Shopping With Noya" />
  <meta property="og:description" content="Daily deal roundups and top savings updated every day." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://deals.shoppingwithnoya.com/blog/" />
  <meta property="og:site_name" content="Shopping With Noya" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Deal Blog — Shopping With Noya" />
  <meta name="twitter:description" content="Daily deal roundups and top savings updated every day." />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-T75YM7DVKJ"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-T75YM7DVKJ');</script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --bg: #0a0a0f; --surface: #13131a; --surface2: #1a1a24; --text: #f0f0f5; --text-sec: #a0a0b0; --accent: #ff3cac; --purple: #7b2fff; --cyan: #00d4ff; --border: rgba(255,255,255,0.08); }
    html { background: var(--bg); color: var(--text); font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; gap: 8px;
      padding: 0 1.5rem; height: 56px;
      background: rgba(10,10,15,0.85);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo {
      font-size: 1.1rem; font-weight: 700; text-decoration: none; flex-shrink: 0;
      background: linear-gradient(135deg, var(--accent), var(--purple), var(--cyan));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .nav-spacer { flex: 1; }
    .nav-link { font-size: 0.78rem; font-weight: 600; color: var(--text); text-decoration: none; white-space: nowrap; flex-shrink: 0; padding: 0.4rem 0.75rem; border-radius: 999px; border: 1px solid var(--border); transition: background 0.2s; }
    .nav-link:hover { background: var(--surface2); text-decoration: none; }
    .nav-tg { display: flex; align-items: center; gap: 0.3rem; padding: 0.4rem 0.75rem; background: linear-gradient(135deg, var(--accent), var(--purple)); color: white !important; text-decoration: none; border-radius: 999px; font-size: 0.78rem; font-weight: 600; transition: opacity 0.2s; flex-shrink: 0; white-space: nowrap; }
    .nav-tg:hover { opacity: 0.85; text-decoration: none; }

    .page-body { max-width: 800px; margin: 0 auto; padding: 40px 24px; }
    h1 { font-size: 2rem; font-weight: 800; margin-bottom: 8px; }
    .subtitle { color: var(--text-sec); margin-bottom: 40px; font-size: 1rem; }

    .post-list { display: flex; flex-direction: column; gap: 16px; }
    .post-card {
      background: var(--surface); border-radius: 16px; padding: 20px 24px;
      display: flex; justify-content: space-between; align-items: center;
      text-decoration: none; color: var(--text); gap: 16px;
      border: 1px solid var(--border);
      transition: background 0.15s, transform 0.1s;
    }
    .post-card:hover { background: var(--surface2); transform: translateY(-2px); text-decoration: none; }
    .post-title { font-size: 1.05rem; font-weight: 700; margin-bottom: 6px; }
    .post-meta { font-size: 0.82rem; color: var(--text-sec); }
    .post-cats { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .cat-tag { font-size: 0.72rem; padding: 3px 8px; border-radius: 20px; background: var(--surface2); color: var(--text-sec); border: 1px solid var(--border); }
    .post-arrow { font-size: 1.4rem; color: var(--text-sec); flex-shrink: 0; }
    .loading { text-align: center; color: var(--text-sec); padding: 60px 0; }

    footer { margin-top: 60px; border-top: 1px solid var(--border); }
    .footer-inner { max-width: 1200px; margin: 0 auto; padding: 24px; text-align: center; font-size: 0.8rem; color: var(--text-sec); }
    .disclaimer { font-size: 0.72rem; opacity: 0.5; margin-top: 6px; }
    a { color: var(--cyan); text-decoration: none; }
  </style>
</head>
<body>

  <nav>
    <a href="/" class="nav-logo">🛍️ Shopping With Noya</a>
    <div class="nav-spacer"></div>
    <a href="/" class="nav-link">🏷️ All Deals</a>
    <a href="https://t.me/shoppingwithnoya" class="nav-tg" target="_blank" rel="noopener">📲 Join Telegram</a>
  </nav>

  <div class="page-body">
    <h1>📝 Deal Blog</h1>
    <p class="subtitle">Daily deal roundups — hand-picked savings updated every day.</p>
    <div class="post-list" id="post-list">
      <div class="loading">Loading posts...</div>
    </div>
  </div>

  <footer>
    <div class="footer-inner">
      <a href="/">← Back to all deals</a> &nbsp;·&nbsp;
      <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener">📲 Telegram</a>
      <p class="disclaimer">#ad — As an affiliate partner I earn from qualifying purchases.</p>
    </div>
  </footer>

  <script>
    async function loadBlog() {
      const list = document.getElementById('post-list');
      try {
        const res = await fetch('/blog-data.json?t=' + Date.now());
        if (!res.ok) throw new Error('Not found');
        const data = await res.json();
        const posts = data.posts || [];
        if (posts.length === 0) {
          list.innerHTML = '<div class="loading">No posts yet — check back soon!</div>';
          return;
        }
        list.innerHTML = posts.map(p => `
          <a href="/blog/${p.slug}/" class="post-card">
            <div>
              <div class="post-title">${p.title}</div>
              <div class="post-meta">${p.deals.length} deals · ${new Date(p.date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</div>
              <div class="post-cats">${(p.categories || []).slice(0,4).map(c => `<span class="cat-tag">${c}</span>`).join('')}</div>
            </div>
            <div class="post-arrow">›</div>
          </a>`).join('');
      } catch (e) {
        list.innerHTML = '<div class="loading">Could not load posts. Try refreshing.</div>';
      }
    }
    loadBlog();
  </script>

</body>
</html>
