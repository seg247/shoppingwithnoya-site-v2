---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shopping With Noya — Best Amazon Deals</title>
  <meta name="description" content="The best Amazon deals updated every day. Save big on home, beauty, kitchen, and more." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0A0A0F;
      --surface: #13131A;
      --elevated: #1C1C28;
      --border: #2A2A3E;
      --pink: #FF3CAC;
      --purple: #7B2FBE;
      --cyan: #00D4FF;
      --green: #39FF14;
      --text: #F0F0FF;
      --text-sec: #9999BB;
      --text-muted: #55556A;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      width: 100%;
      max-width: 100vw;
    }

    /* NAV */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      height: 64px;
      background: rgba(10,10,15,0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--pink), var(--purple), var(--cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-decoration: none;
    }
    .nav-tg {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 1.1rem;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      color: white;
      text-decoration: none;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: opacity 0.2s, transform 0.2s;
    }
    .nav-tg:hover { opacity: 0.85; transform: scale(1.04); }

    /* HERO */
    .hero {
      position: relative;
      min-height: 44vh;        /* shorter hero — deals visible sooner */
      max-height: 520px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2.5rem 1.5rem;
      overflow: hidden;
    }
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.35;
      pointer-events: none;
    }
    .orb-1 { width: 400px; height: 400px; background: var(--pink); top: -80px; left: -80px; animation: float1 8s ease-in-out infinite; }
    .orb-2 { width: 350px; height: 350px; background: var(--purple); bottom: -60px; right: -60px; animation: float2 10s ease-in-out infinite; }
    .orb-3 { width: 300px; height: 300px; background: var(--cyan); top: 40%; left: 50%; transform: translate(-50%,-50%); animation: float3 12s ease-in-out infinite; }

    @keyframes float1 {
      0%,100% { transform: translate(0,0); }
      50% { transform: translate(30px, 40px); }
    }
    @keyframes float2 {
      0%,100% { transform: translate(0,0); }
      50% { transform: translate(-40px, -30px); }
    }
    @keyframes float3 {
      0%,100% { transform: translate(-50%,-50%); }
      50% { transform: translate(-50%,-60%); }
    }

    .hero-content { position: relative; z-index: 2; max-width: 780px; }
    .hero-badge {
      display: inline-block;
      padding: 0.3rem 1rem;
      background: rgba(255,60,172,0.15);
      border: 1px solid rgba(255,60,172,0.3);
      border-radius: 999px;
      font-size: 0.8rem;
      color: var(--pink);
      margin-bottom: 1.5rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .hero h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(2.2rem, 6vw, 4rem);
      font-weight: 700;
      line-height: 1.15;
      margin-bottom: 1.25rem;
      background: linear-gradient(135deg, #fff 0%, var(--pink) 50%, var(--cyan) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-sub {
      font-size: 1.15rem;
      color: var(--text-sec);
      margin-bottom: 2.5rem;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }
    .stats-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      margin-bottom: 2.5rem;
    }
    .stat-pill {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.25rem;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.9rem;
      backdrop-filter: blur(10px);
    }
    .stat-pill strong { color: var(--cyan); font-family: 'Space Mono', monospace; }
    .hero-cta {
      display: block;
      width: 100%;
      max-width: 420px;
      margin: 0 auto;
      padding: 1rem 2rem;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      color: white;
      text-decoration: none;
      border-radius: 14px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 0 24px rgba(255,60,172,0.3);
    }
    .hero-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(255,60,172,0.5); }

    /* SEARCH */
    .search-wrap {
      max-width: 900px;
      margin: 0 auto 1.5rem;
      padding: 0 1.5rem;
    }
    .search-input {
      width: 100%;
      height: 52px;
      padding: 0 1.25rem 0 3rem;
      background: var(--elevated);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      color: var(--text);
      font-size: 1rem;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .search-input::placeholder { color: var(--text-muted); }
    .search-input:focus {
      border-color: var(--pink);
      box-shadow: 0 0 0 3px rgba(255,60,172,0.15);
    }
    .search-container { position: relative; }
    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 1.1rem;
      pointer-events: none;
    }

    /* FILTER CHIPS */
    .chips-wrap {
      max-width: 900px;
      margin: 0 auto 2rem;
      padding: 0 1.5rem;
    }
    .chips-scroll {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }
    .chips-scroll::-webkit-scrollbar { display: none; }
    .chip {
      flex-shrink: 0;
      padding: 0.45rem 1.1rem;
      border: 1.5px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      color: var(--text-sec);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.18s;
      white-space: nowrap;
    }
    .chip:hover { border-color: var(--pink); color: var(--text); }
    .chip.active {
      background: linear-gradient(135deg, var(--pink), var(--purple));
      border-color: transparent;
      color: white;
      font-weight: 600;
    }

    /* DEALS SECTION */
    .deals-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 12px 4rem;
    }
    @media (min-width: 640px) { .deals-section { padding: 0 16px 4rem; } }
    @media (min-width: 1024px) { .deals-section { padding: 0 24px 4rem; } }

    .section-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
    }
    .deal-count {
      font-size: 0.82rem;
      color: var(--text-muted);
      padding: 0.2rem 0.65rem;
      background: var(--elevated);
      border-radius: 999px;
    }

    /* GRID — mobile: 1 col, tablet: 2 col, desktop: 3 col, wide: 4 col */
    .deals-grid {
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
    }
    @media (min-width: 540px) {
      .deals-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    }
    @media (min-width: 900px) {
      .deals-grid { grid-template-columns: repeat(3, 1fr); gap: 14px; }
    }
    @media (min-width: 1200px) {
      .deals-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; }
    }

    /* CARD — horizontal on mobile, vertical on desktop */
    .deal-card {
      display: flex;
      flex-direction: row;      /* horizontal on mobile */
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      color: var(--text);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      opacity: 0;
      animation: fadeInUp 0.35s ease forwards;
      min-height: 90px;
    }
    .deal-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 28px rgba(255,60,172,0.18);
      border-color: rgba(255,60,172,0.35);
    }
    @media (min-width: 540px) {
      .deal-card {
        flex-direction: column; /* vertical on tablet/desktop */
        min-height: unset;
        height: 100%;
      }
    }

    /* IMAGE WRAP */
    .card-image-wrap {
      /* Mobile: fixed square */
      width: 90px;
      height: 90px;
      flex-shrink: 0;
      background: #1a1a24;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6px;
      overflow: hidden;
      position: relative;
    }
    .card-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;   /* CONTAIN — never crops product photos */
      display: block;
    }
    @media (min-width: 540px) {
      .card-image-wrap {
        width: 100%;
        height: 160px;        /* fixed height — uniform rows */
        padding: 12px;
      }
    }

    /* Discount badge on image */
    .discount-badge {
      position: absolute;
      top: 6px;
      right: 6px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 6px;
      color: white;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      white-space: nowrap;
    }
    .discount-badge.hot  { background: linear-gradient(135deg, #ff6b35, var(--pink)); }
    .discount-badge.fire { background: linear-gradient(135deg, #ff3333, var(--pink)); }

    /* CARD BODY */
    .card-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 8px 10px 10px;
      gap: 4px;
      min-width: 0;            /* critical: prevents text overflow in flex */
    }
    @media (min-width: 540px) {
      .card-body { padding: 11px 12px 13px; gap: 6px; }
    }

    .cat-chip {
      display: inline-block;
      padding: 1px 7px;
      background: rgba(123,47,190,0.18);
      border: 1px solid rgba(123,47,190,0.3);
      border-radius: 999px;
      font-size: 0.65rem;
      color: #b07dff;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      align-self: flex-start;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1.35;
      color: var(--text);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0;
    }
    @media (min-width: 540px) { .card-title { font-size: 0.88rem; } }

    /* Price row */
    .card-price-row {
      display: flex;
      align-items: baseline;
      gap: 5px;
      flex-wrap: wrap;
    }
    .price-current {
      font-family: 'Space Mono', monospace;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--cyan);
    }
    .price-original {
      font-family: 'Space Mono', monospace;
      font-size: 0.75rem;
      color: var(--text-muted);
      text-decoration: line-through;
    }
    .price-savings {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--green);
    }

    /* Card footer */
    .card-meta {
      margin-top: auto;
      font-size: 0.68rem;
      color: var(--text-muted);
      padding: 4px 0 3px 2px;
    }

    /* CTA button — only on desktop (mobile: whole card is tap target) */
    .card-cta {
      display: none;
    }
    @media (min-width: 540px) {
      .card-cta {
        display: block;
        width: 100%;
        text-align: center;
        background: linear-gradient(135deg, var(--pink), var(--purple));
        color: #ffffff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        margin-top: 6px;
        transition: opacity 0.15s, transform 0.15s;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
        letter-spacing: 0.02em;
      }
      .card-cta:hover { opacity: 0.88; transform: scale(1.01); }
    }

    /* SKELETON */
    .skeleton-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: row;
      min-height: 90px;
    }
    @media (min-width: 540px) {
      .skeleton-card { flex-direction: column; }
    }
    .skeleton-img {
      width: 90px; height: 90px; flex-shrink: 0;
      background: var(--elevated);
    }
    @media (min-width: 540px) {
      .skeleton-img { width: 100%; height: 160px; }
    }
    .skeleton-body { flex: 1; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
    .skeleton-line {
      height: 10px; border-radius: 5px;
      background: linear-gradient(90deg, var(--elevated) 25%, #22223a 50%, var(--elevated) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
    }
    .skeleton-line.short  { width: 35%; }
    .skeleton-line.medium { width: 60%; }
    .skeleton-line.full   { width: 90%; }
    .skeleton-btn { height: 32px; border-radius: 8px; margin-top: 4px; background: linear-gradient(90deg, var(--elevated) 25%, #22223a 50%, var(--elevated) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }

    @keyframes shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .orb { animation: none; }
      .deal-card { animation: none; opacity: 1; }
      .skeleton-line, .skeleton-btn { animation: none; }
    }

    /* NO RESULTS */
    .no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-sec);
    }
    .no-results h3 { font-size: 1.3rem; margin-bottom: 0.5rem; }

    /* TG BANNER */
    .tg-banner {
      margin: 0 1.5rem 3rem;
      max-width: calc(1200px - 3rem);
      margin-left: auto;
      margin-right: auto;
      padding: 2.5rem 2rem;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      border-radius: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
    }
    .tg-banner h2 { font-family: 'Space Grotesk', sans-serif; font-size: 1.6rem; font-weight: 700; }
    .tg-banner p { opacity: 0.9; max-width: 480px; }
    .tg-banner-btn {
      display: inline-block;
      padding: 0.75rem 2rem;
      background: white;
      color: var(--purple);
      border-radius: 999px;
      text-decoration: none;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .tg-banner-btn:hover { transform: scale(1.04); box-shadow: 0 4px 20px rgba(0,0,0,0.3); }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--border);
      padding: 2rem 1.5rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      line-height: 1.7;
    }
    footer a { color: var(--text-sec); text-decoration: none; }
    footer a:hover { color: var(--pink); }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="#" class="nav-logo">🛍️ Noya</a>
    <a href="https://t.me/shoppingwithnoya" class="nav-tg" target="_blank" rel="noopener">
      📲 Join Telegram
    </a>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="hero-content">
      <div class="hero-badge">✨ Fresh deals added daily</div>
      <h1>Best Amazon Deals,<br/>Zero Effort. 🛍️</h1>
      <p class="hero-sub">Hand-picked deals delivered to your feed. Save more, stress less, shop smarter.</p>
      <div class="stats-row">
        <div class="stat-pill"><strong id="stat-total">—</strong> <span>deals live</span></div>
        <div class="stat-pill"><strong>Free</strong> <span>always &amp; forever</span></div>
        <div class="stat-pill"><strong>Live</strong> <span>deals on Telegram</span></div>
      </div>
      <a href="https://t.me/shoppingwithnoya" class="hero-cta" target="_blank" rel="noopener">
        🔔 Get Instant Deal Alerts on Telegram →
      </a>
    </div>
  </section>

  <!-- SEARCH -->
  <div class="search-wrap">
    <div class="search-container">
      <span class="search-icon">🔍</span>
      <input type="text" class="search-input" id="search-input" placeholder="Search deals..." autocomplete="off" />
    </div>
  </div>

  <!-- FILTER CHIPS -->
  <div class="chips-wrap">
    <div class="chips-scroll" id="chips">
      <button class="chip active" data-cat="all">All</button>
      <button class="chip" data-cat="electronics">Electronics</button>
      <button class="chip" data-cat="home">Home &amp; Kitchen</button>
      <button class="chip" data-cat="beauty">Beauty</button>
      <button class="chip" data-cat="fashion">Fashion</button>
      <button class="chip" data-cat="toys">Toys</button>
      <button class="chip" data-cat="sports">Sports</button>
      <button class="chip" data-cat="pet">Pet Supplies</button>
    </div>
  </div>

  <!-- DEALS -->
  <section class="deals-section">
    <div class="section-header">
      <h2 class="section-title">Latest Deals</h2>
      <span class="deal-count" id="deal-count">Loading...</span>
    </div>
    <div class="deals-grid" id="deals-grid">
      <!-- skeletons injected by JS -->
    </div>
  </section>

  <!-- TG BANNER -->
  <div class="tg-banner">
    <h2>Never Miss a Deal 🔥</h2>
    <p>Join 1000s of smart shoppers getting the best Amazon deals delivered instantly to their Telegram.</p>
    <a href="https://t.me/shoppingwithnoya" class="tg-banner-btn" target="_blank" rel="noopener">
      📲 Join @shoppingwithnoya — It's Free
    </a>
  </div>

  <!-- FOOTER -->
  <footer>
    <p>© 2026 Shopping With Noya · <a href="https://t.me/shoppingwithnoya" target="_blank">Telegram</a></p>
    <p style="margin-top:0.5rem;">As an Amazon Associate I earn from qualifying purchases. Prices and availability are accurate at time of posting.</p>
  </footer>

  <script define:vars={{ base }}>
    const DATA_URL = `${base}/site-data.json?t=${Date.now()}`;
    const CHIP_MAP = {
      all: null,
      electronics: ['electronics', 'computers', 'smart home', 'amazon devices', 'video games'],
      home: ['home', 'kitchen', 'appliance', 'tools'],
      beauty: ['beauty', 'health', 'personal care'],
      fashion: ['fashion', 'clothing', 'shoes', 'jewelry', 'accessories'],
      toys: ['toy', 'baby', 'kids'],
      sports: ['sport', 'outdoor', 'automotive', 'garden'],
      pet: ['pet']
    };

    let allDeals = [];
    let activeFilter = 'all';
    let searchQuery = '';

    // Skeletons
    function renderSkeletons(n = 8) {
      const grid = document.getElementById('deals-grid');
      grid.innerHTML = Array(n).fill(0).map(() => `
        <div class="skeleton-card">
          <div class="skeleton-img"></div>
          <div class="skeleton-body">
            <div class="skeleton-line short"></div>
            <div class="skeleton-line full"></div>
            <div class="skeleton-line medium"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      `).join('');
    }

    function timeAgo(dateStr) {
      if (!dateStr) return '';
      const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
      if (diff < 60) return 'just now';
      if (diff < 3600) return `${Math.floor(diff/60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff/3600)}h ago`;
      return `${Math.floor(diff/86400)}d ago`;
    }

    function getImageUrl(deal) {
      if (deal.imageUrl) return deal.imageUrl;
      if (deal.asin) return `https://images-na.ssl-images-amazon.com/images/P/${deal.asin}.01._SCLZZZZZZZ_.jpg`;
      return '';
    }

    function renderCard(deal, index) {
      const img = getImageUrl(deal);
      const discount = deal.discount || 0;
      const delay = Math.min(index * 55, 550);

      // Discount badge class
      let badgeClass = '';
      if (discount >= 60) badgeClass = 'fire';
      else if (discount >= 40) badgeClass = 'hot';

      // Price
      let priceNum = null;
      if (deal.price) priceNum = parseFloat(String(deal.price).replace(/[^0-9.]/g, ''));

      let priceHtml = '';
      if (priceNum && priceNum > 0) {
        priceHtml = `<div class="card-price-row">
          <span class="price-current">$${priceNum.toFixed(2)}</span>`;
        if (discount > 0) {
          const original = priceNum / (1 - discount / 100);
          priceHtml += `<span class="price-original">$${original.toFixed(2)}</span>
            <span class="price-savings">-${discount}%</span>`;
        }
        priceHtml += `</div>`;
      } else if (discount > 0) {
        priceHtml = `<div class="card-price-row"><span class="price-savings">-${discount}% off</span></div>`;
      }

      const cat = (deal.category || '').substring(0, 20);

      return `<a href="${deal.url}" class="deal-card" target="_blank" rel="noopener sponsored" style="animation-delay:${delay}ms">
        <div class="card-image-wrap">
          ${img ? `<img src="${img}" alt="" loading="lazy" onerror="this.style.opacity='0'" />` : ''}
          ${discount > 0 ? `<div class="discount-badge ${badgeClass}">-${discount}%</div>` : ''}
        </div>
        <div class="card-body">
          ${cat ? `<span class="cat-chip">${cat}</span>` : ''}
          <p class="card-title">${deal.title || 'Amazon Deal'}</p>
          ${priceHtml}
          <div class="card-meta">${timeAgo(deal.ts)}</div>
          <a href="${deal.url}" class="card-cta" target="_blank" rel="noopener sponsored">🛍️ Shop Deal →</a>
        </div>
      </a>`;
    }

    function getFilteredDeals() {
      return allDeals.filter(d => {
        const catKeywords = CHIP_MAP[activeFilter];
        let catMatch = true;
        if (catKeywords) {
          const catLower = (d.category || '').toLowerCase();
          catMatch = catKeywords.some(k => catLower.includes(k));
        }
        let searchMatch = true;
        if (searchQuery) {
          searchMatch = (d.title || '').toLowerCase().includes(searchQuery.toLowerCase());
        }
        return catMatch && searchMatch;
      });
    }

    function renderDeals() {
      const filtered = getFilteredDeals();
      const grid = document.getElementById('deals-grid');
      const count = document.getElementById('deal-count');
      count.textContent = `${filtered.length} deals`;

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="no-results"><h3>😢 No deals found</h3><p>Try a different search or filter</p></div>`;
        return;
      }
      grid.innerHTML = filtered.map((d, i) => renderCard(d, i)).join('');
    }

    // Fetch
    renderSkeletons();
    fetch(DATA_URL)
      .then(r => r.json())
      .then(data => {
        allDeals = data.posts || [];
        document.getElementById('stat-total').textContent = allDeals.length;
        renderDeals();
      })
      .catch(err => {
        console.error('Failed to load deals', err);
        document.getElementById('deals-grid').innerHTML = `<div class="no-results"><h3>⚠️ Failed to load deals</h3><p>Please refresh and try again</p></div>`;
        document.getElementById('deal-count').textContent = 'error';
      });

    // Filter chips
    document.getElementById('chips').addEventListener('click', e => {
      const chip = e.target.closest('.chip');
      if (!chip) return;
      document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      activeFilter = chip.dataset.cat;
      renderDeals();
    });

    // Search
    let searchTimer;
    document.getElementById('search-input').addEventListener('input', e => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        searchQuery = e.target.value.trim();
        renderDeals();
      }, 220);
    });
  </script>
</body>
</html>
