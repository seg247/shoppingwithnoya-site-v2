  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0A0A0F;
      --surface: #16161F;
      --elevated: #1E1E2A;
      --border: #2A2A3E;
      --pink: #FF3CAC;
      --purple: #7B2FBE;
      --cyan: #00D4FF;
      --green: #39FF14;
      --text: #F0F0FF;
      --text-sec: #9999BB;
      --text-muted: #55556A;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      width: 100%;
      max-width: 100vw;
    }

    /* NAV */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 0 0.75rem;
      height: 56px;
      background: rgba(10,10,15,0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }
    @media (min-width: 480px) {
      nav { gap: 10px; padding: 0 1rem; }
    }
    .nav-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--pink), var(--purple), var(--cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-decoration: none;
      flex-shrink: 0;
    }
    /* SEARCH BAR — standalone below hero */
    .search-wrap {
      max-width: 640px;
      margin: 1.5rem auto 1rem;
      padding: 0 1rem;
      position: relative;
      z-index: 2;
    }
    .search-icon {
      position: absolute;
      left: 1.85rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1rem;
      pointer-events: none;
      color: var(--text-muted);
    }
    .search-clear {
      position: absolute;
      right: 1.85rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.1rem;
      cursor: pointer;
      padding: 4px;
      display: none;
      line-height: 1;
    }
    .search-clear.visible { display: block; }
    #search-input {
      width: 100%;
      height: 48px;
      padding: 0 2.5rem 0 2.75rem;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      color: var(--text);
      font-size: 1rem;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    #search-input::placeholder { color: var(--text-muted); }
    #search-input:focus {
      border-color: var(--pink);
      box-shadow: 0 0 0 3px rgba(255,60,172,0.15);
    }
    .nav-tg {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.4rem 0.75rem;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      color: white;
      text-decoration: none;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      transition: opacity 0.2s, transform 0.2s;
      flex-shrink: 0;
      white-space: nowrap;
    }
    .nav-tg:hover { opacity: 0.85; transform: scale(1.04); }
    .nav-fb { background: linear-gradient(135deg, #1877f2, #145db2); }
    /* Hide Facebook button label on small screens — icon only */
    .nav-fb .nav-btn-label { display: none; }
    @media (min-width: 420px) { .nav-fb .nav-btn-label { display: inline; } }
    .nav-follow { font-size: 0.75rem; color: var(--text-sec); white-space: nowrap; flex-shrink: 0; display: none; }
    @media (min-width: 480px) { .nav-follow { display: inline; } }
    .nav-blog-link {
      font-size: 0.78rem; font-weight: 600; color: var(--text);
      text-decoration: none; white-space: nowrap; flex-shrink: 0;
      padding: 0.4rem 0.75rem; border-radius: 999px;
      border: 1px solid var(--border);
      transition: background 0.2s;
    }
    .nav-blog-link:hover { background: var(--surface); text-decoration: none; }
    /* Push social buttons to the right */
    .nav-spacer { flex: 1; }

    /* HERO */
    /* HERO STRIP */
    .visually-hidden {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }
    .hero-strip {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 1rem;
      padding: 0.85rem 1.25rem;
      background: linear-gradient(135deg, rgba(255,60,172,0.12), rgba(123,47,190,0.12));
      border-bottom: 1px solid var(--border);
    }
    .hero-strip-left {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      align-items: center;
    }
    .hero-strip-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(0.9rem, 3vw, 1.15rem);
      font-weight: 700;
      background: linear-gradient(135deg, #fff 0%, var(--pink) 60%, var(--cyan) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hero-strip-stat {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .hero-strip-stat strong {
      color: var(--cyan);
      font-family: 'Space Mono', monospace;
    }
    .hero-strip-cta {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 1.1rem;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      color: white;
      text-decoration: none;
      border-radius: 999px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      white-space: nowrap;
      transition: opacity 0.2s, transform 0.2s;
      box-shadow: 0 0 16px rgba(255,60,172,0.25);
    }
    .hero-strip-cta:hover { opacity: 0.88; transform: scale(1.03); }
    @media (max-width: 400px) {
      .hero-strip { flex-wrap: wrap; }
      .hero-strip-stat { display: none; }
    }

    /* FILTER CHIPS */
    /* Fade hints on both edges */
    .chip {
      flex-shrink: 0;
      padding: 0.45rem 1.1rem;
      border: 1.5px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      color: var(--text-sec);
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.18s;
      white-space: nowrap;
    }
    .chip:hover { border-color: var(--pink); color: var(--text); }
    .chip.active {
      background: linear-gradient(135deg, var(--pink), var(--purple));
      border-color: transparent;
      color: white;
      font-weight: 600;
    }

    /* DEALS SECTION */
    .deals-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 12px 4rem;
    }
    @media (min-width: 640px) { .deals-section { padding: 0 16px 4rem; } }
    @media (min-width: 1024px) { .deals-section { padding: 0 24px 4rem; } }

    .section-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
    }
    .deal-count {
      font-size: 0.82rem;
      color: var(--text-muted);
      padding: 0.2rem 0.65rem;
      background: var(--elevated);
      border-radius: 999px;
    }

    /* GRID — mobile: 1 col, tablet: 2 col, desktop: 3 col, wide: 4 col */
    .deals-grid {
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr;
    }
    @media (min-width: 540px) {
      .deals-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    }
    @media (min-width: 900px) {
      .deals-grid { grid-template-columns: repeat(3, 1fr); gap: 14px; }
    }
    @media (min-width: 1200px) {
      .deals-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; }
    }

    /* CARD — horizontal on mobile, vertical on desktop */
    .deal-card {
      display: flex;
      flex-direction: row;      /* horizontal on mobile */
      background: var(--surface);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      overflow: hidden;
      text-decoration: none;
      color: var(--text);
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      opacity: 0;
      animation: fadeInUp 0.35s ease forwards;
      min-height: 100px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }
    .deal-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 28px rgba(255,60,172,0.18);
      border-color: rgba(255,60,172,0.35);
    }
    @media (min-width: 540px) {
      .deal-card {
        flex-direction: column; /* vertical on tablet/desktop */
        min-height: unset;
        height: 100%;
      }
    }
    /* Cards without images — text takes full width */
    .deal-card.no-img {
      flex-direction: column;
    }
    .deal-card.no-img .card-body {
      padding: 12px 14px;
    }

    /* IMAGE WRAP */
    .card-image-wrap {
      /* Mobile: fixed square, no separator — image is part of the card */
      width: 110px;
      height: auto;
      min-height: 110px;
      flex-shrink: 0;
      background: var(--surface);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      overflow: hidden;
      position: relative;
    }
    .card-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      border-radius: 8px;
    }
    @media (min-width: 540px) {
      .card-image-wrap {
        width: 100%;
        height: 170px;
        padding: 14px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
      }
    }

    /* Discount badge on image */
    .discount-badge {
      position: absolute;
      top: 6px;
      right: 6px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 6px;
      color: white;
      background: linear-gradient(135deg, var(--pink), var(--purple));
      white-space: nowrap;
    }
    .discount-badge.hot  { background: linear-gradient(135deg, #ff6b35, var(--pink)); }
    .discount-badge.fire { background: linear-gradient(135deg, #ff3333, var(--pink)); }
    .badge-expires {
      display: inline-block; font-size: 0.65rem; font-weight: 600;
      background: #0ff4; color: #0dd; border: 1px solid #0dd;
      border-radius: 4px; padding: 1px 6px; margin-bottom: 4px;
    }
    .badge-expired {
      display: inline-block; font-size: 0.65rem; font-weight: 700;
      background: #f002; color: #f66; border: 1px solid #f66;
      border-radius: 4px; padding: 1px 6px; margin-bottom: 4px;
    }
    .promo-code-badge {
      display: inline-block; font-family: monospace; font-size: 0.75rem; font-weight: 700;
      background: #1a0a1e; color: #ff90c8; border: 1px solid #ff60a8;
      border-radius: 5px; padding: 3px 8px; margin: 4px 0;
      letter-spacing: 0.05em;
    }
    .card-expired { opacity: 0.5; }

    /* CARD BODY */
    .card-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 10px 12px 12px;
      gap: 5px;
      min-width: 0;            /* critical: prevents text overflow in flex */
    }
    @media (min-width: 540px) {
      .card-body { padding: 12px 14px 14px; gap: 6px; }
    }

    .cat-chip {
      display: inline-block;
      padding: 1px 7px;
      background: rgba(123,47,190,0.18);
      border: 1px solid rgba(123,47,190,0.3);
      border-radius: 999px;
      font-size: 0.65rem;
      color: #b07dff;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      align-self: flex-start;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1.35;
      color: var(--text);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0;
    }
    @media (min-width: 540px) { .card-title { font-size: 0.88rem; } }

    /* Price row */
    .card-price-row {
      display: flex;
      align-items: baseline;
      gap: 5px;
      flex-wrap: wrap;
    }
    .price-current {
      font-family: 'Space Mono', monospace;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--cyan);
    }
    .price-original {
      font-family: 'Space Mono', monospace;
      font-size: 0.75rem;
      color: var(--text-muted);
      text-decoration: line-through;
    }
    .price-savings {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--green);
    }

    /* Card footer — date + share inline */
    .card-footer {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 4px;
    }
    .card-meta {
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    /* CTA button — only on desktop (mobile: whole card is tap target) */
    .card-cta {
      display: none;
    }
    @media (min-width: 540px) {
      .card-cta {
        display: block;
        width: 100%;
        text-align: center;
        background: linear-gradient(135deg, var(--pink), var(--purple));
        color: #ffffff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        margin-top: 6px;
        transition: opacity 0.15s, transform 0.15s;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
        letter-spacing: 0.02em;
      }
      .card-cta:hover { opacity: 0.88; transform: scale(1.01); }
    }

    /* Share button — small, inline in card footer */
    .share-btn {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.1);
      background: transparent;
      color: var(--text-sec);
      cursor: pointer;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .share-btn:hover {
      border-color: var(--pink);
      color: var(--pink);
      background: rgba(255,60,172,0.08);
    }

    /* SKELETON */
    .skeleton-card {
      background: var(--surface);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: row;
      min-height: 100px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }
    @media (min-width: 540px) {
      .skeleton-card { flex-direction: column; }
    }
    .skeleton-img {
      width: 100px; height: 100px; flex-shrink: 0;
      background: var(--elevated);
    }
    @media (min-width: 540px) {
      .skeleton-img { width: 100%; height: 170px; }
    }
    .skeleton-body { flex: 1; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
    .skeleton-line {
      height: 10px; border-radius: 5px;
      background: linear-gradient(90deg, var(--elevated) 25%, #22223a 50%, var(--elevated) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
    }
    .skeleton-line.short  { width: 35%; }
    .skeleton-line.medium { width: 60%; }
    .skeleton-line.full   { width: 90%; }
    .skeleton-btn { height: 32px; border-radius: 8px; margin-top: 4px; background: linear-gradient(90deg, var(--elevated) 25%, #22223a 50%, var(--elevated) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }

    @keyframes shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .orb { animation: none; }
      .deal-card { animation: none; opacity: 1; }
      .skeleton-line, .skeleton-btn { animation: none; }
    }

    /* NO RESULTS */
    .no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-sec);
    }
    .no-results h3 { font-size: 1.3rem; margin-bottom: 0.5rem; }

    /* TG BANNER */
    .tg-banner {
      margin: 0 1.5rem 3rem;
      max-width: calc(1200px - 3rem);
      margin-left: auto;
      margin-right: auto;
      padding: 2.5rem 2rem;
