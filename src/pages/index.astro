    <div class="deals-grid" id="deals-grid">
      <!-- skeletons injected by JS -->
    </div>
  </section>

  <!-- TG BANNER -->
  <div class="tg-banner">
    <h2>Never Miss a Deal 🔥</h2>
    <p>Join 1000s of smart shoppers getting the best deals delivered instantly to their Telegram.</p>
    <a href="https://t.me/shoppingwithnoya" class="tg-banner-btn" target="_blank" rel="noopener">
      📲 Join @shoppingwithnoya — It's Free
    </a>
  </div>

  <!-- BOUTIQUE BANNER -->
  <div class="tg-banner" style="background: linear-gradient(135deg, #7B2FBE, #FF3CAC); margin-top: 0;">
    <h2>👗 Shop My Clothing Boutique</h2>
    <p>Stylish, affordable women's clothing for every body — tops, dresses, swimwear & more. Prices starting at just $10!</p>
    <a href="https://shoppingwithnoya.com" class="tg-banner-btn" target="_blank" rel="noopener">
      🛒 Shop Now → shoppingwithnoya.com
    </a>
  </div>

  <!-- FOOTER -->
  <footer>
    <p>
      <a href="https://t.me/shoppingwithnoya" target="_blank" rel="noopener">📲 Telegram</a>
      &nbsp;·&nbsp;
      <a href="https://www.facebook.com/groups/1224964507605101" target="_blank" rel="noopener">👥 Facebook Group</a>
      &nbsp;·&nbsp;
