---
import siteData from '../data/site-data.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Static links to the category landing pages. The on-page filter bar is
// client-side JS, so without these there is no crawlable path from the
// homepage to /category/* and the new pages would be orphaned.
// Must stay in sync with the MIN_DEALS + META list in category/[slug].astro.
const CATEGORY_LINKS = [
  { name: 'Grocery & Food',  emoji: '🛒', slug: 'grocery-food' },
  { name: 'Home & Kitchen',  emoji: '🏠', slug: 'home-kitchen' },
  { name: 'Beauty',          emoji: '💄', slug: 'beauty' },
  { name: 'Electronics',     emoji: '📱', slug: 'electronics' },
  { name: 'Fashion',         emoji: '👗', slug: 'fashion' },
  { name: 'Garden & Outdoor',emoji: '🌿', slug: 'garden-outdoor' },
  { name: 'Health',          emoji: '💊', slug: 'health' },
  { name: 'Toys & Kids',     emoji: '🧸', slug: 'toys-kids' },
  { name: 'Cleaning Supplies',emoji: '🧹', slug: 'cleaning-supplies' },
  { name: 'Pet Supplies',    emoji: '🐾', slug: 'pet-supplies' },
];

const catCounts = (() => {
  const c = {};
  for (const p of (siteData.posts || [])) {
    if (!p.category) continue;
    c[p.category] = (c[p.category] || 0) + 1;
  }
  return c;
})();

const shopCategories = CATEGORY_LINKS
  .map((c) => ({ ...c, count: catCounts[c.name] || 0 }))
  .filter((c) => c.count >= 12);

// Server-rendered deal cards.
//
// The grid is populated client-side from site-data.json, so before this the
// homepage shipped ZERO href="/deals/..." links: no internal link equity
// reached the 500 deal pages, and AI answer engines (which do not run JS) saw
// a page claiming "500 deals live" and listing none.
//
// These cards render in static HTML and link to the internal deal page rather
// than straight out to Amazon, so the homepage actually feeds its own site.
// The client script replaces the grid once site-data.json loads, so filtering
// and search behave exactly as before.
const SSR_COUNT = 60;

const ssrDeals = (siteData.posts || [])
  .filter((d) => {
    if (!d.expiresAt) return true;
    const days = (Date.now() - new Date(d.expiresAt + 'T23:59:59').getTime()) / 864e5;
    return days <= 3;
  })
  .slice(0, SSR_COUNT);

const cleanTitleSSR = (t) =>
  (t || '')
    .replace(/^[^\w$]+/, '')
    .replace(/\s+/g, ' ')
    .trim() || 'Amazon Deal';

const timeAgoSSR = (ts) => {
  const mins = Math.floor((Date.now() - new Date(ts).getTime()) / 60000);
  if (mins < 60) return mins + 'm ago';
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return hrs + 'h ago';
  return Math.floor(hrs / 24) + 'd ago';
};

