    footer a:hover { color: var(--pink); }
  
    /* Shop-by-category strip. One horizontally scrollable row rather than a
       wrapping block — wrapping produced three stacked rows on mobile that
       collided with the search field above it. */
    .shop-cats{position:relative;z-index:1;max-width:1200px;margin:0 auto 18px;padding:0 24px;clear:both}
    .shop-cats-label{display:block;font-size:.78rem;color:var(--text-muted,#8888a0);margin-bottom:8px}
    .shop-cats-scroll{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;scroll-behavior:smooth}
    .shop-cats-scroll::-webkit-scrollbar{display:none}
    /* Desktop (mouse/trackpad) cannot swipe, so give the row a real scrollbar
       plus arrow buttons. Touch devices keep the clean hidden-scrollbar look. */
    @media(hover:hover) and (pointer:fine){
      .shop-cats-scroll{scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.25) transparent}
      .shop-cats-scroll::-webkit-scrollbar{display:block;height:6px}
