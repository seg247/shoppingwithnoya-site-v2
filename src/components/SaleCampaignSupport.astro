---
import createCampaignPolicy from '../lib/sale-campaign.cjs';
---
<style is:global>
  .sale-campaign {
    display: inline-block; align-self: flex-start; width: fit-content; max-width: 100%;
    padding: 3px 8px; border-radius: 6px; border: 1px solid #a82350;
    background: #ffe4eb; color: #86133e; font: 700 11px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    white-space: normal; overflow-wrap: anywhere; position: static;
  }
  .sale-campaign[hidden] { display: none !important; }
</style>
<script is:inline set:html={`window.NoyaSaleCampaign = (${createCampaignPolicy.toString()})();`} />
<script is:inline>
  (() => {
    const policy = window.NoyaSaleCampaign;
    let timer;
    function refreshSaleCampaigns() {
      clearTimeout(timer);
      if (!window.document) return;
      let next = Infinity;
      for (const badge of document.querySelectorAll('[data-sale-campaign]')) {
        let deal;
        try { deal = JSON.parse(badge.dataset.saleCampaign); } catch { badge.remove(); continue; }
        const campaign = policy.getCampaign(deal);
        if (!campaign) { badge.remove(); continue; }
        next = Math.min(next, Date.parse(campaign.validUntil));
      }
      if (Number.isFinite(next)) timer = setTimeout(refreshSaleCampaigns, Math.min(2147483647, Math.max(0, next - Date.now())));
    }
    new MutationObserver(refreshSaleCampaigns).observe(document.documentElement, {subtree:true, childList:true, attributes:true, attributeFilter:['data-sale-campaign']});
    document.addEventListener('visibilitychange', refreshSaleCampaigns);
    window.addEventListener('pageshow', refreshSaleCampaigns);
    refreshSaleCampaigns();
  })();
</script>
